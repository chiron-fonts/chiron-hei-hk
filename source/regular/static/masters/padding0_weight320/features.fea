## > Remote Merge Start: feature.numr,feature.dnom,feature.frac,feature.ordn,feature.sups,feature.subs,feature.sinf,feature.onum,feature.pnum,feature.case,feature.titl,feature.c2sc,feature.smcp,feature.cv01,feature.ss01,feature.ss02,feature.ss03,feature.ss04,feature.ss05,feature.ss06,feature.ss07,feature.ss08,feature.ss09,feature.ss10,feature.salt,feature.zero,feature.hlig,feature.size <
feature numr { # Numerators
    	lookup NUMR {
    		sub @SS_FIGURES_LINING_TABULAR by @SS_FIGURES_NUMERATOR;
    		sub @SS_PUNCTUATION_FOR_SMALL_FIGURE_STYLES by @SS_PUNCTUATION_NUMERATOR;
    	} NUMR;
    } numr;

feature dnom { # Denominators
    	sub @SS_FIGURES_LINING_TABULAR by @SS_FIGURES_DENOMINATOR;
    	sub @SS_PUNCTUATION_FOR_SMALL_FIGURE_STYLES by @SS_PUNCTUATION_DENOMINATOR;
    } dnom;

feature frac { # Fractions
    	@SS_SLASH = [ \45932 \45927 \45929 ];

    	lookup NUMR;
    	sub \44414 by \45932;
    	sub @SS_FIGURES_NUMERATOR \41000' by \46855;

    	sub [ @SS_SLASH @SS_FIGURES_DENOMINATOR @SS_PUNCTUATION_DENOMINATOR ] [ @SS_FIGURES_NUMERATOR @SS_PUNCTUATION_NUMERATOR ]' by [ @SS_FIGURES_DENOMINATOR @SS_PUNCTUATION_DENOMINATOR ];
    	sub @SS_FIGURES_DENOMINATOR \46855 [ @SS_FIGURES_NUMERATOR @SS_PUNCTUATION_NUMERATOR ]' by [ @SS_FIGURES_DENOMINATOR @SS_PUNCTUATION_DENOMINATOR ];
    } frac;

feature ordn {
    	lookup SUPERIOR_LETTERS_MINISCULE;
    } ordn;

feature sups { # Superscript
    	lookup SUPERIOR_LETTERS_MINISCULE;
    	lookup SUPERIOR_LETTERS_MAJUSCULE;
    	lookup SUPERIOR_NUMERALS_SORTS;
    	lookup SUPERIOR_SORTS;
    } sups;

feature subs { # Subscript
    	lookup INFERIOR;
    } subs;

feature sinf { # Scientific Inferiors
    	lookup INFERIOR;
    } sinf;

feature onum { # Oldstyle (Text) Figures
    	lookup OLDSTYLE;
    } onum;

feature pnum { # Proportional Figures
    	lookup PROPORTIONAL;
    } pnum;

feature case { # Case-Sensitive Forms

    	lookup CASING_ALTERNATES {
    		sub [ \41818 \41858 \42034 \42312 \42252 \42253 \42338 \46453 ] by [ \41260 \41298 \41481 \42998 \41620 \41652 \41626 \44492 ];
    	} CASING_ALTERNATES;

    	lookup MARKS_CASE {
    		sub @SS_MARKS_CMB_LC by @SS_MARKS_CMB_CASE;
    	} MARKS_CASE;

    	lookup FIGURES_CASE;

    	lookup PUNCTUATION_CASE {
    		sub [ \44484 \44320 \44323 \44438 ] by [ \44486 \44487 \44489 \44491 ];
    		sub \43580 by \43582;
    	} PUNCTUATION_CASE;

    } case;

feature titl { # Titling Forms
    	lookup FIGURES_CASE;
    } titl;

