feature cv01 { # Character Variant 1 — serifed I forms

    	cvParameters {
    		FeatUILabelNameID {
    			name 3 1 0x0409 "Serifed I (\25B2 i)"; # English US: "Serifed I (▲ i)"
    			name 3 1 0x0809 "Serifed I (\25B2 i)"; # English GB
