feature locl {
    script latn;
    
    language dflt;
    lookup latin_special;
    
    ## >>> Combine remote language definitions
    lookup GREEK_TO_IPA;
    ## <<< Combine remote language definition
    
    language JAN exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHS exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHT exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHH exclude_dflt;
    lookup jpcntwhk_special;
    
    ## >>> Append remote-exclusive language definitions
    language ATH include_dflt;
    lookup OGONEK_ALTERNATES;
    
    language CHP include_dflt;
    lookup OGONEK_ALTERNATES;
    
    language NAV include_dflt;
    lookup OGONEK_ALTERNATES;
    
    language NSM include_dflt;
    lookup ENG_UC_ALTERNATE;
    
    language SLA include_dflt;
    lookup OGONEK_ALTERNATES;
    
    language SKS include_dflt;
    lookup ENG_UC_ALTERNATE;
    
    language IPPH include_dflt;
    lookup A_IPA; # ITALIC ONLY substitutes single-storey a with double-storey variants
    
    language APPH include_dflt;
    lookup A_IPA;
    
    ## <<< Append remote-exclusive language definitions
    
    
    script grek;
    
    language dflt;
    lookup latin_special;
    
    ## >>> Combine remote language definitions
    sub [ \46465 \46455 \46529 \46537 \46801 ] by [ \46470 \46463 \46536 \46543 \46803 ]; # combining marks
    ## <<< Combine remote language definition
    
    language JAN exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHS exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHT exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHH exclude_dflt;
    lookup jpcntwhk_special;
    
    ## >>> Append remote-exclusive language definitions
    language PGR include_dflt;
    lookup GREEK_POLYTONIC_TONOS_TO_ACUTE { # replaces steep-angled tonos with acute forms
        sub [ \43008 \43012 \43071 \43075 \43084 \43090 \43100 ] by [ \43348 \43373 \43388 \43405 \43442 \43462 \43492 ];
    } GREEK_POLYTONIC_TONOS_TO_ACUTE;
    
    ## <<< Append remote-exclusive language definitions
    
    
    script cyrl;
    
    language dflt;
    lookup latin_special;
    
    ## >>> Combine remote language definitions
    lookup CYRILLIC_BREVE { # heavy terminals (Cyrillic preference)
        sub [ \46487 \46489 ] by [ \46491 \46493 ]; # combining marks
    } CYRILLIC_BREVE;
    @SS_CYRILLIC_BGR_DEFAULT = [ \43831 \43834 \43842 \43844 \43845 \43856 \43860 \43869 \43874 \43876 \43916 ];
    @SS_CYRILLIC_BGR_CURSIVE = [ \44098 \44099 \44103 \44105 \44106 \44107 \44110 \44113 \44116 \44118 \44121 ];
    ## <<< Combine remote language definition
    
    language JAN exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHS exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHT exclude_dflt;
    lookup jpcntwhk_special;
    
    language ZHH exclude_dflt;
    lookup jpcntwhk_special;
    
    ## >>> Append remote-exclusive language definitions
    language BGR include_dflt; # Bulgarian
    lookup CYRILLIC_GEOMETRIC_ALTERNATES;
    lookup CYRILLIC_LC_ASCENDING_ALTERNATES;
    lookup BGR_CURSIVE {
        sub @SS_CYRILLIC_BGR_DEFAULT by @SS_CYRILLIC_BGR_CURSIVE;
    } BGR_CURSIVE;
    
    language SRB include_dflt; # Serbian
    lookup CYRILLIC_BE_LC_CURSIVE;
    
    language MKD include_dflt; # Macedonian
    
    ## <<< Append remote-exclusive language definitions
    
    
    script kana;
    
    language JAN;
    lookup jpcntwhk_special;
    
    language ZHS;
    lookup jpcntwhk_special;
    
    language ZHT;
    lookup jpcntwhk_special;
    
    language ZHH;
    lookup jpcntwhk_special;
    
    
    
    script hang;
    
    language JAN;
    lookup jpcntwhk_special;
    
    language ZHS;
    lookup jpcntwhk_special;
    
    language ZHT;
    lookup jpcntwhk_special;
    
    language ZHH;
    lookup jpcntwhk_special;
    
    
    
    script hani;
    
    language JAN;
    lookup jpcntwhk_special;
    
    language ZHS;
    lookup jpcntwhk_special;
    
    language ZHT;
    lookup jpcntwhk_special;
    
    language ZHH;
    lookup jpcntwhk_special;
    
    
    
} locl;

